{
    "name": "neo-digital/contao-basic-bundle",
    "type": "library",
    "description": "Shared foundation for a family of Contao extensions: one back-end page for access keys and licences, one AI connection, one Azure Translator access, encryption of stored keys, the model list of the route, the licence check of paid extensions and the credit line of their free editions.",
    "keywords": [
        "contao",
        "ai",
        "llm",
        "requesty",
        "azure-translator",
        "licence"
    ],
    "homepage": "https://github.com/NEO-Digital-AT/contao-basic-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "NEO Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/NEO-Digital-AT/contao-basic-bundle/issues",
        "source": "https://github.com/NEO-Digital-AT/contao-basic-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "composer-runtime-api": "^2.0",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "knplabs/knp-menu": "^3.1",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Neo\\BasicBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neo\\BasicBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "contao-manager-plugin": "Neo\\BasicBundle\\ContaoManager\\Plugin"
    }
}
